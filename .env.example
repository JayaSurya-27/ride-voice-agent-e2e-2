# Required secrets (the only five the agent needs). Copy to .env.local and fill in.
# LiveKit Cloud is the media/SIP control plane. Agent logic and data run locally.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Deepgram: speech-to-text and text-to-speech (Aura).
DEEPGRAM_API_KEY=
# Gemini API (not Vertex): the language model.
GEMINI_API_KEY=

# Non-secret defaults (optional; these are the values used when unset).
TOOLS_API_URL=http://localhost:18090
TOOLS_TIMEOUT_SECONDS=5
DEMO_CALLER_ANI=+14155550101
AGENT_STT_MODEL=flux-general-en
AGENT_STT_MODEL_PHONE=nova-2-phonecall
AGENT_LLM_MODEL=gemini-2.5-flash-lite
AGENT_LLM_TEMPERATURE=0.2
AGENT_TTS_MODEL=aura-2-andromeda-en
